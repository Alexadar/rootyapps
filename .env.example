# Credentials for the marketing/logic scripts. Copy to `.env` and fill in.
#
#   set -a; . ./.env; set +a          # bash/zsh — exports everything for a script run
#
# `.env` is gitignored; THIS file is committed, so it must never contain a real value.
# The key files themselves live in `keys/`, which has been gitignored since the repo started —
# private key material is never inlined here, only the path to it.

# ── App Store Connect ─────────────────────────────────────────────────────────
# Used by marketing/logic/asc_client.py (JWT ES256). The same values are duplicated in the
# app-store-connect MCP server config in ~/.claude.json as APP_STORE_CONNECT_KEY_ID / _ISSUER_ID /
# _P8_PATH — if you rotate the key, change both.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=/absolute/path/to/rootyapps/keys/AuthKey_XXXXXXXXXX.p8.txt

# ── Apple Ads (formerly Apple Search Ads) ─────────────────────────────────────
# Campaign Management API v5. OAuth2 client-credentials, NOT the ASC scheme:
#   1. sign a client-secret JWT with ADS_PRIVATE_KEY_PATH (ES256, kid=ADS_KEY_ID,
#      sub=ADS_CLIENT_ID, iss=ADS_TEAM_ID, aud=https://appleid.apple.com, exp < 180d from iat)
#   2. POST https://appleid.apple.com/auth/oauth2/token with grant_type=client_credentials,
#      client_id, client_secret=<JWT>, scope=searchadsorg  ->  access_token, expires_in 3600
#   3. GET https://api.searchads.apple.com/api/v5/me  ("Get Me Details") -> parentOrgId = ADS_ORG_ID
#
# ADS_ORG_ID then goes in an `X-AP-Context: orgId=<n>` header on EVERY request. The ONLY endpoints
# that do not require it are Get Me Details and Get User ACL (/acls) — which is exactly why one of
# them has to be the bootstrap call. Omitting the header elsewhere is the most common cause of a
# correct-looking request failing.
#
# Getting the credentials is a TWO-step UI path, and the API tab does not appear until step 1 is
# done: an Account Admin assigns an API role (API Account Manager / API Account Read Only) under
# Account Settings -> User Management; THEN that user opens Account Settings -> API to upload the
# public key. Verified against Apple's docs 2026-08-03.
#
# Tier: Apple's help page does not state one. The Campaign Management API is generally understood to
# be an Advanced-experience feature — if the API tab never appears, check which tier the account is on.
ADS_CLIENT_ID=SEARCHADS.00000000-0000-0000-0000-000000000000
ADS_TEAM_ID=SEARCHADS.00000000-0000-0000-0000-000000000000
ADS_KEY_ID=00000000-0000-0000-0000-000000000000
ADS_PRIVATE_KEY_PATH=/absolute/path/to/rootyapps/keys/apple-ads-private-key.pem
# Discovered by the /acls call above — leave blank until then.
ADS_ORG_ID=
