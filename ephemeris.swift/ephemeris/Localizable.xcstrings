          }
        }
      }
    },
    "Without a birth time the day tables are used. Triplicity rulers differ between day and night charts, so these scores may shift.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez času narození se používají denní tabulky. Vládci triplicity se u denních a nočních nativit liší, takže se tato skóre mohou změnit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Geburtszeit werden die Tagtabellen verwendet. Triplizitätsherrscher unterscheiden sich zwischen Tag- und Nachthoroskopen, diese Werte können sich also verschieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς ώρα γέννησης χρησιμοποιούνται οι ημερήσιοι πίνακες. Οι κυβερνήτες τριπλότητας διαφέρουν σε ημερήσιους και νυχτερινούς χάρτες, οπότε οι βαθμοί μπορεί να αλλάξουν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin hora de nacimiento se usan las tablas diurnas. Los regentes de triplicidad difieren entre cartas diurnas y nocturnas, así que estas puntuaciones pueden cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans heure de naissance, les tables diurnes sont utilisées. Les maîtres de triplicité diffèrent entre thèmes diurnes et nocturnes : ces scores peuvent donc changer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Születési idő nélkül a nappali táblákat használjuk. A triplicitás urai eltérnek nappali és éjszakai horoszkópban, így ezek a pontszámok változhatnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza ora di nascita si usano le tavole diurne. I governatori di triplicità cambiano tra temi diurni e notturni, quindi questi punteggi possono variare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出生時刻がない場合は昼のテーブルを使用します。トリプリシティの支配星は昼と夜のチャートで異なるため、点数が変わる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출생 시각이 없으면 주간 표를 사용합니다. 삼분성 지배성은 주간과 야간 차트에서 다르므로 점수가 달라질 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder geboortetijd worden de dagtabellen gebruikt. Triplicteitsheersers verschillen tussen dag- en nachthoroscopen, dus deze scores kunnen verschuiven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez godziny urodzenia używane są tabele dzienne. Władcy triplicytetu różnią się między kosmogramami dziennymi i nocnymi, więc te wyniki mogą się zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem hora de nascimento são usadas as tabelas diurnas. Os regentes de triplicidade diferem entre mapas diurnos e noturnos, então estas pontuações podem mudar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără ora nașterii se folosesc tabelele diurne. Guvernatorii de triplicitate diferă între hărțile diurne și nocturne, deci aceste scoruri se pot schimba."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan födelsetid används dagtabellerna. Triplicitetshärskare skiljer sig mellan dag- och natthoroskop, så dessa poäng kan ändras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğum saati olmadan gündüz tabloları kullanılır. Üçlü yöneticiler gündüz ve gece haritalarında farklıdır, bu yüzden bu puanlar değişebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без часу народження використовуються денні таблиці. Володарі триплицитету різняться для денних і нічних карт, тож ці оцінки можуть змінитися."
          }
        }
      }
    },
    "Written to a temporary file and handed to your share sheet. Nothing is uploaded.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapíše se do dočasného souboru a předá sdílení. Nic se nenahrává."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird in eine temporäre Datei geschrieben und an die Teilen-Ansicht übergeben. Nichts wird hochgeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράφεται σε προσωρινό αρχείο και δίνεται στο φύλλο κοινοποίησης. Τίποτα δεν ανεβαίνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escribe en un archivo temporal y se pasa a la hoja para compartir. No se sube nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit dans un fichier temporaire et transmis à la feuille de partage. Rien n’est téléversé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideiglenes fájlba írjuk és átadjuk a megosztásnak. Semmi nem töltődik fel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritto in un file temporaneo e passato al foglio di condivisione. Nulla viene caricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時ファイルに書き出し、共有シートに渡します。アップロードはされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 파일로 저장한 뒤 공유 시트에 전달합니다. 업로드되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar een tijdelijk bestand geschreven en aan het deelvenster gegeven. Er wordt niets geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisywane do pliku tymczasowego i przekazywane do udostępniania. Nic nie jest wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravado em um arquivo temporário e entregue à folha de compartilhamento. Nada é enviado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scris într-un fișier temporar și predat foii de partajare. Nimic nu este încărcat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivs till en tillfällig fil och lämnas till delningsvyn. Inget laddas upp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçici bir dosyaya yazılır ve paylaşım sayfasına verilir. Hiçbir şey yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записується у тимчасовий файл і передається аркушу поширення. Нічого не завантажується."
          }
        }
      }
    },
