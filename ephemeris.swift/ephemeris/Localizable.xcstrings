    "Set a place in the Moment card to see the Ascendant, Midheaven and houses.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege im Zeitpunkt-Bereich einen Ort fest, um Aszendent, Medium Coeli und Häuser zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un lieu dans la carte Moment pour voir l'Ascendant, le Milieu du Ciel et les maisons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define un lugar en la tarjeta Momento para ver el Ascendente, el Medio Cielo y las casas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un luogo nella scheda Momento per vedere Ascendente, Medio Cielo e case."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw miejsce w karcie Moment, aby zobaczyć Ascendent, Medium Coeli i domy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте місце в картці «Момент», щоб побачити асцендент, середину неба та доми."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte místo v kartě Okamžik, abyste viděli ascendent, Medium Coeli a domy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állíts be egy helyet az Időpont kártyán az aszcendens, a Medium Coeli és a házak megjelenítéséhez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează un loc în cardul Moment pentru a vedea Ascendentul, Mijlocul Cerului și casele."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίστε τόπο στην κάρτα Στιγμή για να δείτε τον ωροσκόπο, το μεσουράνημα και τους οίκους."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükselen, tepe noktası ve evleri görmek için An kartında bir yer belirleyin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een plaats in bij Moment om ascendant, midhemel en huizen te zien."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en plats i Ögonblick-kortet för att se ascendent, himmelens mitt och hus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アセンダント・ミッドヘブン・ハウスを表示するには、時刻カードで場所を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상승궁, 천정, 하우스를 보려면 시각 카드에서 장소를 설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um local no cartão Momento para ver o Ascendente, o Meio do Céu e as casas."
          }
        }
      },
      "comment": "Empty state when no location is set"
    },
