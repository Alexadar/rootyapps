    "%@ is undefined this far from the equator — showing Whole Sign.": {
      "comment": "1 = house system name. Placidus/Koch break down past the polar circle.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ není v této šířce definován — zobrazuji Celá znamení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist in dieser Breite nicht definiert – es wird Ganzes Zeichen angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ δεν ορίζεται σε αυτό το γεωγραφικό πλάτος — εμφανίζεται Ολόκληρο Ζώδιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está definido a esta latitud: se muestra Signos enteros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas défini à cette latitude — affichage en Signes entiers."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ezen a szélességen nem értelmezett — Egész jegy látható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è definito a questa latitudine: mostro Segni interi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この緯度では%@は定義されません。ホールサインを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위도에서는 %@를 정의할 수 없어 홀사인으로 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is op deze breedtegraad niet gedefinieerd — Heel Teken wordt getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie jest zdefiniowany na tej szerokości — pokazuję Cały Znak."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não é definido nesta latitude — exibindo Signo Inteiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu este definit la această latitudine — se afișează Semn întreg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är inte definierat på denna latitud – visar Helt tecken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu enlemde tanımsız — Tam Burç gösteriliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не визначено на цій широті — показано Цілий знак."
          }
        }
      }
    },
