    "%@ sit exactly opposite, so their midpoint could be either of two points.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stojí přesně proti sobě, jejich střed tedy může být jeden ze dvou bodů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stehen exakt gegenüber, ihre Halbsumme kann daher einer von zwei Punkten sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ βρίσκονται ακριβώς αντίθετα, οπότε το μέσο σημείο τους μπορεί να είναι ένα από δύο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ están exactamente opuestos, así que su punto medio puede ser uno de dos puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sont exactement opposés : leur point médian peut donc être l'un de deux points."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pontosan szemben állnak, így a felezőpontjuk két pont egyike lehet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sono esattamente opposti, quindi il loro punto medio può essere uno di due punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はちょうど正反対にあるため、中点は2つの点のどちらにもなり得ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 이(가) 정확히 반대편에 있어 중간점이 두 지점 중 하나일 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ staan exact tegenover elkaar, dus hun middelpunt kan een van twee punten zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stoją dokładnie naprzeciw, więc ich punkt środkowy może być jednym z dwóch punktów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ estão exatamente opostos, então seu ponto médio pode ser um de dois pontos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sunt exact opuse, deci punctul lor median poate fi unul din două puncte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ står exakt mitt emot varandra, så deras mittpunkt kan vara en av två punkter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tam karşıt konumda; bu yüzden orta noktaları iki noktadan biri olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ стоять точно навпроти, тож їхня середня точка може бути однією з двох."
          }
        }
      }
    },
