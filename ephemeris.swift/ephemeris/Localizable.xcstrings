    "Comparing needs two charts. This is the only one saved.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnání vyžaduje dvě nativity. Tato je jediná uložená."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Vergleich braucht es zwei Horoskope. Dies ist das einzige gespeicherte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύγκριση χρειάζεται δύο χάρτες. Αυτός είναι ο μόνος αποθηκευμένος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparar necesita dos cartas. Esta es la única guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparer demande deux thèmes. Celui-ci est le seul enregistré."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összevetéshez két horoszkóp kell. Ez az egyetlen mentett."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il confronto richiede due temi. Questo è l'unico salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較には2つのチャートが必要です。保存されているのはこれだけです。"
