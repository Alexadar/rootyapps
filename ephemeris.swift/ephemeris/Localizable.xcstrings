    "Adds a ✨ button that answers questions about whatever screen you are on, using Apple Intelligence on your device. Nothing is sent anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá tlačítko ✨, které odpovídá na otázky o aktuální obrazovce pomocí Apple Intelligence ve vašem zařízení. Nic se neodesílá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt eine ✨-Taste hinzu, die Fragen zum aktuellen Bildschirm mit Apple Intelligence auf deinem Gerät beantwortet. Es wird nichts gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέτει ένα κουμπί ✨ που απαντά σε ερωτήσεις για την τρέχουσα οθόνη με Apple Intelligence στη συσκευή σας. Τίποτα δεν αποστέλλεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un botón ✨ que responde preguntas sobre la pantalla actual con Apple Intelligence en tu dispositivo. No se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un bouton ✨ qui répond aux questions sur l’écran actuel avec Apple Intelligence sur votre appareil. Rien n’est envoyé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzáad egy ✨ gombot, amely az aktuális képernyőről válaszol az Apple Intelligence segítségével a készülékeden. Semmi nem kerül elküldésre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un pulsante ✨ che risponde a domande sulla schermata attuale con Apple Intelligence sul tuo dispositivo. Nulla viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の画面についての質問に、デバイス上の Apple Intelligence で答える ✨ ボタンを追加します。データは送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 화면에 대한 질문에 기기의 Apple Intelligence로 답하는 ✨ 버튼을 추가합니다. 아무것도 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt een ✨-knop toe die vragen over het huidige scherm beantwoordt met Apple Intelligence op je apparaat. Er wordt niets verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje przycisk ✨, który odpowiada na pytania o bieżący ekran za pomocą Apple Intelligence na Twoim urządzeniu. Nic nie jest wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um botão ✨ que responde perguntas sobre a tela atual usando a Apple Intelligence no seu dispositivo. Nada é enviado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un buton ✨ care răspunde la întrebări despre ecranul curent folosind Apple Intelligence pe dispozitivul tău. Nu se trimite nimic."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger till en ✨-knapp som svarar på frågor om aktuell skärm med Apple Intelligence på din enhet. Inget skickas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ile cihazınızda, bulunduğunuz ekranla ilgili soruları yanıtlayan bir ✨ düğmesi ekler. Hiçbir şey gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає кнопку ✨, яка відповідає на запитання про поточний екран за допомогою Apple Intelligence на вашому пристрої. Нічого не надсилається."
          }
        }
      }
    },
