    "Set a place in the Moment card to see the Ascendant, Midheaven and houses.": {
      "comment": "Empty state when no location is set",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte místo v kartě Okamžik, abyste viděli ascendent, Medium Coeli a domy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege im Zeitpunkt-Bereich einen Ort fest, um Aszendent, Medium Coeli und Häuser zu sehen."
