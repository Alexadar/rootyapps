          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Północ i wschód są dodatnie. Nic nie jest wyszukiwane online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Norte e leste são positivos. Nada é consultado online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordul și estul sunt pozitive. Nu se caută nimic online."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
