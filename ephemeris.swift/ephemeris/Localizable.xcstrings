    "Ask about anything on this screen, or tap the button below.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptejte se na cokoli na této obrazovce, nebo klepněte na tlačítko níže."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage nach allem auf diesem Bildschirm oder tippe unten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρωτήστε για οτιδήποτε σε αυτήν την οθόνη ή πατήστε το κουμπί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta por cualquier cosa de esta pantalla o toca el botón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question sur cet écran, ou touchez le bouton ci-dessous."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdezz bármiről ezen a képernyőn, vagy koppints a gombra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi qualsiasi cosa di questa schermata o tocca il pulsante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面について何でも質問するか、下のボタンをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면의 무엇이든 물어보거나 아래 버튼을 누르세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag naar alles op dit scherm of tik op de knop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj o cokolwiek na tym ekranie lub dotknij przycisku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte sobre qualquer coisa nesta tela ou toque no botão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întreabă orice despre acest ecran sau atinge butonul."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga om vad som helst på skärmen, eller tryck på knappen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekrandaki her şeyi sorun ya da düğmeye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте про будь-що на цьому екрані або натисніть кнопку."
          }
        }
      }
    },
