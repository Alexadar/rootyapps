          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw miejsce w karcie Moment, aby zobaczyć Ascendent, Medium Coeli i domy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
