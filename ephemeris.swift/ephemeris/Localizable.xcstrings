    "North and east are positive. Nothing is looked up online.": {
      "comment": "Coordinate entry help — stresses the offline promise",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sever a východ jsou kladné. Nic se nevyhledává online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nord und Ost sind positiv. Es wird nichts online abgefragt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο βορράς και η ανατολή είναι θετικά. Δεν γίνεται καμία αναζήτηση online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El norte y el este son positivos. No se consulta nada en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nord et l'est sont positifs. Aucune recherche en ligne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az észak és a kelet pozitív. Semmi nem kerül online lekérdezésre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nord ed est sono positivi. Nulla viene cercato online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "北と東が正です。オンラインでの検索は行いません。"
