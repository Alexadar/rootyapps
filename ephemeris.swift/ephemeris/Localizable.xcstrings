    "The Sun does not rise or set here today, so the day cannot be divided into hours.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slunce dnes zde nevychází ani nezapadá, den proto nelze rozdělit na hodiny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sonne geht hier heute weder auf noch unter, der Tag lässt sich nicht in Stunden teilen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Ήλιος δεν ανατέλλει ούτε δύει εδώ σήμερα, οπότε η μέρα δεν χωρίζεται σε ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy el Sol no sale ni se pone aquí, así que el día no puede dividirse en horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Soleil ne se lève ni ne se couche ici aujourd’hui : la journée ne peut être divisée en heures."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Nap ma itt nem kel fel és nem nyugszik le, így a nap nem osztható órákra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi qui il Sole non sorge né tramonta, quindi il giorno non può essere diviso in ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日ここでは日の出も日の入りもないため、一日を時間に分割できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 이곳에서는 해가 뜨거나 지지 않아 하루를 시간으로 나눌 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zon komt hier vandaag niet op of onder, dus de dag kan niet in uren worden verdeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słońce dziś tu nie wschodzi ani nie zachodzi, więc dnia nie można podzielić na godziny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje o Sol não nasce nem se põe aqui, então o dia não pode ser dividido em horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Astăzi Soarele nu răsare și nu apune aici, deci ziua nu poate fi împărțită în ore."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Solen varken går upp eller ner här i dag, så dagen kan inte delas in i timmar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün burada Güneş doğmuyor ya da batmıyor, bu yüzden gün saatlere bölünemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні тут Сонце не сходить і не заходить, тож день не можна поділити на години."
          }
        }
      }
    },
    "The classical tables assign nothing to the modern planets.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasické tabulky moderním planetám nic nepřiřazují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die klassischen Tabellen weisen den modernen Planeten nichts zu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κλασικοί πίνακες δεν αποδίδουν τίποτα στους σύγχρονους πλανήτες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tablas clásicas no asignan nada a los planetas modernos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tables classiques n'attribuent rien aux planètes modernes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A klasszikus táblák a modern bolygókhoz semmit sem rendelnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tavole classiche non assegnano nulla ai pianeti moderni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古典的な表は現代惑星に何も割り当てていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고전 표는 현대 행성에 아무것도 부여하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De klassieke tabellen kennen de moderne planeten niets toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabele klasyczne nie przypisują nic planetom współczesnym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tabelas clássicas não atribuem nada aos planetas modernos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabelele clasice nu atribuie nimic planetelor moderne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De klassiska tabellerna tilldelar de moderna planeterna ingenting."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasik tablolar modern gezegenlere hiçbir şey atamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Класичні таблиці нічого не призначають сучасним планетам."
          }
        }
      }
    },
    "The sky right now — no birth details needed.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obloha právě teď — bez údajů o narození."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel gerade jetzt — ohne Geburtsdaten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ουρανός αυτή τη στιγμή — χωρίς στοιχεία γέννησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo ahora mismo: sin datos de nacimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ciel en ce moment — sans données de naissance."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az égbolt most — születési adatok nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cielo in questo momento — senza dati di nascita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今の空 — 出生データは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금의 하늘 — 출생 정보가 필요 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hemel op dit moment — geen geboortegegevens nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niebo w tej chwili — bez danych urodzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O céu agora — sem dados de nascimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerul chiar acum — fără date de naștere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Himlen just nu — inga födelseuppgifter behövs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anki gökyüzü — doğum bilgisi gerekmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Небо просто зараз — без даних народження."
          }
        }
      }
    },
