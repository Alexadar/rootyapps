      }
    },
    "Nothing falls in this range — the file would contain only its header.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do tohoto rozsahu nic nespadá — soubor by obsahoval jen hlavičku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesen Zeitraum fällt nichts — die Datei enthielte nur ihre Kopfzeile."
          }
