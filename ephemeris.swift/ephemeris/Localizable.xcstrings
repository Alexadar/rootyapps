          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada cae en este rango: el archivo solo contendría su encabezado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien dans cette plage — le fichier ne contiendrait que son en-tête."
          }
