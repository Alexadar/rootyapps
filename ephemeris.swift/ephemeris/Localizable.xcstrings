    "Sunrise and sunset here fall on different days in the selected time zone. Switch the zone to this place to see its hours.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Východ a západ Slunce zde spadají ve zvoleném časovém pásmu do různých dnů. Přepněte pásmo na toto místo, abyste viděli jeho hodiny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonnenauf- und -untergang fallen hier in der gewählten Zeitzone auf verschiedene Tage. Stelle die Zone auf diesen Ort um, um seine Stunden zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ανατολή και η δύση εδώ πέφτουν σε διαφορετικές ημέρες στην επιλεγμένη ζώνη ώρας. Αλλάξτε τη ζώνη σε αυτόν τον τόπο για να δείτε τις ώρες του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí el amanecer y el atardecer caen en días distintos en la zona horaria elegida. Cambia la zona a este lugar para ver sus horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, le lever et le coucher du soleil tombent des jours différents dans le fuseau choisi. Basculez le fuseau sur ce lieu pour voir ses heures."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A napkelte és a napnyugta itt különböző napokra esik a kiválasztott időzónában. Váltsd a zónát erre a helyre az órák megtekintéséhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui alba e tramonto cadono in giorni diversi nel fuso orario scelto. Imposta il fuso su questo luogo per vederne le ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したタイムゾーンでは、この場所の日の出と日の入りが別の日になります。ゾーンをこの場所に切り替えると時間が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 시간대에서는 이곳의 일출과 일몰이 서로 다른 날에 속합니다. 시간대를 이 장소로 바꾸면 시간이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonsopkomst en -ondergang vallen hier in de gekozen tijdzone op verschillende dagen. Zet de zone op deze plaats om de uren te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wschód i zachód Słońca wypadają tu w różne dni w wybranej strefie czasowej. Przełącz strefę na to miejsce, aby zobaczyć jego godziny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui o nascer e o pôr do sol caem em dias diferentes no fuso horário escolhido. Mude o fuso para este local para ver suas horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici răsăritul și apusul cad în zile diferite în fusul orar ales. Schimbă fusul pe acest loc pentru a-i vedea orele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Soluppgång och solnedgång infaller här på olika dagar i den valda tidszonen. Byt zon till denna plats för att se dess timmar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili saat diliminde buradaki gün doğumu ve batımı farklı günlere denk geliyor. Saatleri görmek için dilimi bu konuma değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вибраному часовому поясі схід і захід Сонця тут припадають на різні дні. Змініть пояс на це місце, щоб побачити його години."
          }
        }
      }
    },
