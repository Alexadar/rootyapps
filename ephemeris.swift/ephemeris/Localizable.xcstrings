    "Comparing needs two charts. This is the only one saved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Vergleich braucht es zwei Horoskope. Dies ist das einzige gespeicherte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparer demande deux thèmes. Celui-ci est le seul enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparar necesita dos cartas. Esta es la única guardada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il confronto richiede due temi. Questo è l'unico salvato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównanie wymaga dwóch kosmogramów. Ten jest jedynym zapisanym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для порівняння потрібні дві карти. Ця — єдина збережена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnání vyžaduje dvě nativity. Tato je jediná uložená."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összevetéshez két horoszkóp kell. Ez az egyetlen mentett."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparația are nevoie de două hărți. Aceasta este singura salvată."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύγκριση χρειάζεται δύο χάρτες. Αυτός είναι ο μόνος αποθηκευμένος."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırma iki harita gerektirir. Kayıtlı olan yalnızca bu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijken vraagt twee horoscopen. Dit is de enige die bewaard is."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att jämföra kräver två horoskop. Detta är det enda sparade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較には2つのチャートが必要です。保存されているのはこれだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교하려면 차트가 두 개 필요합니다. 저장된 것은 이것뿐입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparar exige dois mapas. Este é o único salvo."
          }
        }
      }
    },
