        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebbe a tartományba semmi nem esik — a fájl csak a fejlécét tartalmazná."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
