    "Set a location to see moonrise and moonset.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte polohu, abyste viděli východ a západ Měsíce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege einen Ort fest, um Mondauf- und -untergang zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίστε τοποθεσία για να δείτε ανατολή και δύση Σελήνης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece una ubicación para ver la salida y puesta de la Luna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un lieu pour voir le lever et le coucher de la Lune."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj meg egy helyet a holdkelte és holdnyugta megtekintéséhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta una posizione per vedere il sorgere e il tramonto della Luna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月の出・月の入りを表示するには場所を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월출과 월몰을 보려면 위치를 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een locatie in om maansopkomst en -ondergang te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw lokalizację, aby zobaczyć wschód i zachód Księżyca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um local para ver o nascer e o pôr da Lua."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează o locație pentru a vedea răsăritul și apusul Lunii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en plats för att se månuppgång och månnedgång."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay doğuşu ve batışını görmek için bir konum ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажіть місце, щоб побачити схід і захід Місяця."
          }
        }
      }
    },
