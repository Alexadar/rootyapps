<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  New file: the iOS target had no entitlements at all — only CODE_SIGN_ENTITLEMENTS[sdk=macosx*]
  existed, so iOS was signed with none.

  Deliberately iCloud only. The app group is NOT declared here even though SharedStore reads that
  suite, because adding it would change behaviour on iOS (UserDefaults(suiteName:) currently
  returns nil and falls back to .standard) and that is a separate decision from chart storage.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.oleksandr.aisixteen.ephemeris</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.oleksandr.aisixteen.ephemeris</string>
	</array>
</dict>
</plist>
