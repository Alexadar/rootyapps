    "Current phase, how much is lit, and when the next full moon falls.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuální fáze, osvětlená část a datum příštího úplňku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Phase, beleuchteter Anteil und der nächste Vollmond."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τρέχουσα φάση, φωτισμένο τμήμα και πότε είναι η επόμενη πανσέληνος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase actual, parte iluminada y cuándo cae la próxima luna llena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase actuelle, part éclairée et date de la prochaine pleine lune."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuális fázis, megvilágított rész és a következő telihold időpontja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase attuale, parte illuminata e quando cade la prossima luna piena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の月相、輝面比、次の満月の日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위상, 밝은 부분, 다음 보름달 날짜."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Huidige fase, verlicht deel en wanneer de volgende volle maan valt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżąca faza, oświetlona część i data najbliższej pełni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase atual, parte iluminada e quando cai a próxima lua cheia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faza curentă, partea iluminată și când cade următoarea lună plină."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuvarande fas, upplyst del och när nästa fullmåne infaller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut evre, aydınlık oranı ve bir sonraki dolunayın tarihi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточна фаза, освітлена частина та дата наступної повні."
          }
        }
      }
    },
