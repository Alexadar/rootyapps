    "Which planet rules the current hour, and when it ends.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Která planeta vládne aktuální hodině a kdy končí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Planet die aktuelle Stunde regiert und wann sie endet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποιος πλανήτης κυβερνά την τρέχουσα ώρα και πότε τελειώνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué planeta rige la hora actual y cuándo termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle planète gouverne l’heure actuelle et quand elle se termine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Melyik bolygó uralja az aktuális órát, és mikor ér véget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale pianeta governa l’ora attuale e quando finisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の時間を支配する惑星と、その終了時刻。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 시간을 지배하는 행성과 종료 시각."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke planeet het huidige uur regeert en wanneer het eindigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Która planeta rządzi bieżącą godziną i kiedy się kończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual planeta rege a hora atual e quando ela termina."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce planetă guvernează ora curentă și când se termină."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken planet som styr den aktuella timmen och när den slutar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut saati hangi gezegenin yönettiği ve ne zaman bittiği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яка планета керує поточною годиною і коли вона закінчується."
          }
        }
      }
    }
  },
  "version": "1.0"
}
