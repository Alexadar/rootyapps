{
  "manifest_version": 2,

  "name": "Indox Browser",
  "description": "Indox Browser",
  "version": "1.0",

  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "run_at": "document_start",
      "js": ["content.js"],
      "css": ["modal.css"],
      "matches": ["<all_urls>"]
    }
  ],

  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar-icon-16.png",
      "19": "toolbar-icon-19.png",
      "32": "toolbar-icon-32.png",
      "38": "toolbar-icon-38.png",
      "48": "toolbar-icon-48.png",
      "72": "toolbar-icon-72.png"
    }
  },

  "permissions": ["nativeMessaging"]
}
