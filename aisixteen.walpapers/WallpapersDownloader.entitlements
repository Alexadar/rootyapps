<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The same group as the app: the downloaded asset pack lands in the shared container, and
	     both sides must be able to reach it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.oleksandr.aisixteen.wallpapers</string>
	</array>
</dict>
</plist>
