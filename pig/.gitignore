build/
.build/
DerivedData/
.DS_Store

# Generated by XcodeGen from project.yml — the yml is the source, this is the output.
*.xcodeproj

# Produced media is a local artifact in this repo. The root .gitignore already covers
# marketing/**/video/* and marketing/raw/**/*.mov; this is the belt to that pair of braces.
marketing/**/*.mp4
marketing/**/*.mov
marketing/**/*.png

# …except the app icon, which is tracked source.
!pig.icon/Assets/*.png
