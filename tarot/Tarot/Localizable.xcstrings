    "Apple Intelligence is off. Enable it in Settings → Apple Intelligence & Siri.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist ausgeschaltet. Aktiviere es unter Einstellungen → Apple Intelligence & Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado. Actívalo en Ajustes → Apple Intelligence y Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Activez-le dans Réglages → Apple Intelligence et Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è disattivato. Attivalo in Impostazioni → Apple Intelligence e Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceがオフです。設定 → Apple IntelligenceとSiriからオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 꺼져 있습니다. 설정 → Apple Intelligence 및 Siri에서 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence staat uit. Schakel het in via Instellingen → Apple Intelligence en Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence está desativado. Ative-o em Ajustes → Apple Intelligence e Siri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence är avstängt. Aktivera det i Inställningar → Apple Intelligence och Siri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kapalı. Ayarlar → Apple Intelligence ve Siri bölümünden etkinleştir."
          }
        }
      }
    },
    "Apple Intelligence is still downloading — interpretations will appear once it's ready.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence lädt noch — Deutungen erscheinen, sobald es bereit ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence aún se está descargando: las interpretaciones aparecerán cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est en cours de téléchargement — les interprétations apparaîtront dès qu'il sera prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è in download — le interpretazioni appariranno appena pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceをダウンロード中です。準備ができ次第、解釈が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence를 다운로드하는 중입니다. 준비되면 해석이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wordt nog gedownload — interpretaties verschijnen zodra het klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence ainda está sendo baixado — as interpretações aparecerão quando estiver pronto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence laddas fortfarande ned — tolkningar visas när det är klart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence hâlâ indiriliyor — hazır olunca yorumlar görünecek."
          }
        }
      }
    },
