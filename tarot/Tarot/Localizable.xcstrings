    "Your cards stand as drawn — this reflection is yours to make.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Karten liegen, wie sie gezogen wurden — diese Deutung gehört dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cartas quedan como fueron sacadas: esta reflexión es tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes cartes restent telles qu'elles ont été tirées — cette réflexion t'appartient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue carte restano come sono state estratte — questa riflessione è tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引かれたカードはそのまま。この解釈はあなた自身のものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드는 뽑힌 그대로입니다. 이 해석은 당신의 몫입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kaarten liggen zoals ze zijn getrokken — deze overdenking is aan jou."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas cartas permanecem como foram tiradas — esta reflexão é sua."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina kort ligger som de drogs — den här reflektionen är din."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartların çekildiği gibi duruyor — bu yorum sana ait."
          }
        }
      }
    }
