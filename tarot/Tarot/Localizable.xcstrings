    "The model is still downloading; drawing works meanwhile.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell lädt noch; Karten ziehen funktioniert derweil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo aún se está descargando; mientras tanto puedes tirar las cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle est en cours de téléchargement ; le tirage fonctionne en attendant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello è in download; nel frattempo la stesa funziona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルをダウンロード中です。その間もドローは利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 다운로드하는 중입니다. 그동안에도 카드 뽑기는 가능합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model wordt nog gedownload; leggen werkt ondertussen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo ainda está sendo baixado; enquanto isso, a tiragem funciona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen laddas fortfarande ned; läggningar fungerar under tiden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model hâlâ indiriliyor; bu sırada açılım çalışır."
          }
        }
      }
    },
    "The on-device writer declined this particular draw.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schreiber auf dem Gerät hat diese Legung nicht kommentiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escritor del dispositivo declinó esta tirada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'assistant d'écriture a décliné ce tirage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scrittore sul dispositivo ha rinunciato a questa stesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上のライターがこのドローの解釈を控えました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 작성 모델이 이 카드에 대한 해석을 삼갔습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schrijver op het apparaat heeft deze legging niet becommentarieerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O escritor do aparelho declinou esta tiragem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivaren på enheten avböjde just den här läggningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazdaki yazar bu açılımı yorumlamadı."
          }
        }
      }
    },
