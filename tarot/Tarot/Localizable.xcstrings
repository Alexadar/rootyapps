      }
    },
    "This device can't run Apple Intelligence; draws work without the written reflection.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät unterstützt Apple Intelligence nicht; Legungen funktionieren ohne die geschriebene Deutung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no admite Apple Intelligence; las tiradas funcionan sin la reflexión escrita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne prend pas en charge Apple Intelligence ; les tirages fonctionnent sans la réflexion écrite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non supporta Apple Intelligence; le stese funzionano senza la riflessione scritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはApple Intelligenceに対応していません。ドロー自体は解釈なしで利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 Apple Intelligence를 지원하지 않습니다. 카드 뽑기는 해석 없이 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat ondersteunt Apple Intelligence niet; leggingen werken zonder de geschreven overdenking."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho não é compatível com o Apple Intelligence; as tiragens funcionam sem a reflexão escrita."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten stöder inte Apple Intelligence; läggningar fungerar utan den skrivna eftertanken."
