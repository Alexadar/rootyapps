    "The writing stopped partway.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schreiben brach unterwegs ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura se detuvo a medias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écriture s'est interrompue en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scrittura si è interrotta a metà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みが途中で止まりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성이 도중에 중단되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het schrijven stopte halverwege."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escrita parou no meio."
          }
        },
        "sv": {
