    "No live storm, aurora or flare data right now. Pull to refresh — nothing is shown until it's real.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз немає актуальних даних про бурю, сяйво чи спалахи. Потягніть, щоб оновити — нічого не показуємо, доки дані не справжні."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit keine aktuellen Sturm-, Polarlicht- oder Eruptionsdaten. Zum Aktualisieren ziehen – es wird nichts angezeigt, was nicht echt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée en direct de tempête, d'aurore ou d'éruption. Tirez pour actualiser — rien n'est affiché tant que ce n'est pas réel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no hay datos en vivo de tormenta, aurora ni llamaradas. Desliza para actualizar: no se muestra nada que no sea real."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non ci sono dati in tempo reale su tempeste, aurore o brillamenti. Trascina per aggiornare — non mostriamo nulla che non sia reale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No momento não há dados ao vivo de tempestade, aurora ou erupções. Puxe para atualizar — nada é mostrado até ser real."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit moment geen live storm-, poollicht- of uitbarstingsgegevens. Trek om te verversen — er wordt niets getoond wat niet echt is."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Just nu finns inga livedata om storm, norrsken eller soleruptioner. Dra för att uppdatera – inget visas förrän det är verkligt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sanntidsdata om storm, nordlys eller solutbrudd akkurat nå. Dra for å oppdatere – ingenting vises før det er ekte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen livedata om storm, nordlys eller soludbrud lige nu. Træk for at opdatere – intet vises, før det er ægte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Juuri nyt ei ole reaaliaikaisia myrsky-, revontuli- tai roihutietoja. Vedä päivittääksesi – mitään ei näytetä ennen kuin se on totta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecnie brak danych na żywo o burzy, zorzy czy rozbłyskach. Pociągnij, aby odświeżyć — nic nie jest pokazywane, dopóki nie jest prawdziwe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentálně nejsou k dispozici živá data o bouři, polární záři ani erupcích. Přetažením obnovíte — nic se nezobrazí, dokud to není skutečné."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda canlı fırtına, kutup ışığı veya patlama verisi yok. Yenilemek için çekin — gerçek olmayan hiçbir şey gösterilmez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、嵐・オーロラ・フレアのライブデータはありません。引いて更新してください — 実データが揃うまで何も表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 폭풍·오로라·플레어 실시간 데이터가 없습니다. 당겨서 새로 고침하세요 — 실제 데이터가 아니면 아무것도 표시하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有风暴、极光或耀斑的实时数据。下拉刷新——数据未经证实前不会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有風暴、極光或閃焰的即時資料。下拉重新整理——資料未經證實前不會顯示。"
          }
        }
      }
    },
