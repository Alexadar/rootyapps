    "%@ geomagnetic storm in progress. Faded bars are NOAA's 3-day forecast.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Триває геомагнітна буря: %@. Бліді стовпчики — 3-денний прогноз NOAA."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetischer Sturm im Gange: %@. Blasse Balken sind die 3-Tage-Prognose der NOAA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempête géomagnétique en cours : %@. Les barres pâles sont la prévision NOAA à 3 jours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tormenta geomagnética en curso: %@. Las barras tenues son el pronóstico de 3 días de NOAA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempesta geomagnetica in corso: %@. Le barre chiare sono la previsione NOAA a 3 giorni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempestade geomagnética em curso: %@. As barras claras são a previsão de 3 dias da NOAA."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetische storm aan de gang: %@. Vage balken zijn de 3-daagse NOAA-verwachting."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetisk storm pågår: %@. Bleka staplar är NOAA:s 3-dygnsprognos."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetisk storm pågår: %@. Blasse søyler er NOAAs 3-døgnsvarsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetisk storm i gang: %@. Blege søjler er NOAA's 3-dages prognose."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagneettinen myrsky käynnissä: %@. Haaleat pylväät ovat NOAA:n 3 vuorokauden ennuste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa burza geomagnetyczna: %@. Blade słupki to 3-dniowa prognoza NOAA."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhá geomagnetická bouře: %@. Bledé sloupce jsou třídenní předpověď NOAA."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeomanyetik fırtına sürüyor: %@. Soluk çubuklar NOAA'nın 3 günlük tahminidir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "磁気嵐が発生中：%@。淡いバーは NOAA の3日間予報です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지자기 폭풍 진행 중: %@. 흐린 막대는 NOAA의 3일 예보입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地磁暴进行中：%@。浅色柱为 NOAA 三日预报。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地磁暴進行中：%@。淺色柱為 NOAA 三日預報。"
          }
        }
      }
    },
