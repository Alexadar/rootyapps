    "Geomagnetic (G), Radio blackout (R), Solar radiation (S). 0 means quiet on that axis.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Геомагнітна (G), радіозатемнення (R), сонячна радіація (S). 0 означає спокій за цією віссю."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetisch (G), Funkausfall (R), Sonnenstrahlung (S). 0 bedeutet ruhig auf dieser Achse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Géomagnétique (G), coupure radio (R), radiation solaire (S). 0 signifie calme sur cet axe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnética (G), apagón de radio (R), radiación solar (S). 0 significa calma en ese eje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetica (G), blackout radio (R), radiazione solare (S). 0 significa calma su quell'asse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnética (G), apagão de rádio (R), radiação solar (S). 0 significa calmo nesse eixo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetisch (G), radiostoring (R), zonnestraling (S). 0 betekent rustig op die as."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetisk (G), radiobortfall (R), solstrålning (S). 0 betyder lugnt på den axeln."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetisk (G), radiobrudd (R), solstråling (S). 0 betyr rolig på den aksen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetisk (G), radioudfald (R), solstråling (S). 0 betyder roligt på den akse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagneettinen (G), radiokatko (R), auringon säteily (S). 0 tarkoittaa rauhallista tällä akselilla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetyczna (G), zanik radiowy (R), promieniowanie słoneczne (S). 0 oznacza spokój na tej osi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Geomagnetická (G), výpadek rádia (R), sluneční záření (S). 0 znamená klid na dané ose."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeomanyetik (G), telsiz kesintisi (R), güneş radyasyonu (S). 0, o eksende sakin demektir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地磁気 (G)、短波通信障害 (R)、太陽放射線 (S)。0 はその軸が静穏であることを意味します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지자기 (G), 무선 장애 (R), 태양 방사선 (S). 0은 해당 축이 조용함을 뜻합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地磁 (G)、无线电中断 (R)、太阳辐射 (S)。0 表示该轴平静。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地磁 (G)、無線電中斷 (R)、太陽輻射 (S)。0 表示該軸平靜。"
          }
        }
      }
    },
