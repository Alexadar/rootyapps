    "Planetary Kp, storm level, aurora chance and solar wind — live from NOAA.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Планетарний Kp, рівень бурі, шанс сяйва та сонячний вітер — наживо від NOAA."
          }
        },
        "de": {
          "stringUnit": {
