            "state": "translated",
            "value": "Apagões de rádio: %1$@. Tempestade de radiação: %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Radiostoringen: %1$@. Stralingsstorm: %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radiobortfall: %1$@. Strålningsstorm: %2$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Radiobrudd: %1$@. Strålingsstorm: %2$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Radioudfald: %1$@. Strålingsstorm: %2$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Radiokatkot: %1$@. Säteilymyrsky: %2$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaniki radiowe: %1$@. Burza radiacyjna: %2$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výpadky rádia: %1$@. Radiační bouře: %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telsiz kesintileri: %1$@. Radyasyon fırtınası: %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短波通信障害：%1$@。放射線嵐：%2$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무선 장애: %1$@. 방사선 폭풍: %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无线电中断：%1$@。辐射风暴：%2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無線電中斷：%1$@。輻射風暴：%2$@。"
          }
        }
      },
      "comment": "%1$@ is an R label, %2$@ an S label"
    },
    "Refreshes only on Wi-Fi. On cellular the app pauses and keeps showing the last reading rather than failing silently.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлюється лише через Wi-Fi. У мобільній мережі застосунок призупиняється і показує останнє значення, а не мовчки збоїть."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert nur über WLAN. Im Mobilfunk pausiert die App und zeigt weiter den letzten Wert, statt still zu versagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualisation en Wi-Fi uniquement. En cellulaire, l'app se met en pause et continue d'afficher la dernière valeur au lieu d'échouer en silence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se actualiza por Wi-Fi. Con datos móviles la app se pausa y sigue mostrando la última lectura en vez de fallar en silencio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aggiorna solo via Wi-Fi. Su rete cellulare l'app si mette in pausa e continua a mostrare l'ultima lettura invece di fallire in silenzio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza só no Wi-Fi. Nos dados móveis o app pausa e continua mostrando a última leitura em vez de falhar em silêncio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ververst alleen via wifi. Op mobiel pauzeert de app en blijft de laatste meting tonen in plaats van stilletjes te falen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdaterar bara via Wi-Fi. På mobilnät pausar appen och visar den senaste avläsningen i stället för att tyst misslyckas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdaterer bare over Wi-Fi. På mobilnett settes appen på pause og viser siste måling i stedet for å feile stille."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdaterer kun via Wi-Fi. På mobilnet sætter appen på pause og viser fortsat den seneste måling i stedet for at fejle i stilhed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivittyy vain Wi-Fissä. Mobiiliverkossa sovellus keskeyttää ja näyttää edelleen viimeisimmän lukeman sen sijaan että epäonnistuisi hiljaa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odświeża tylko przez Wi-Fi. W sieci komórkowej aplikacja wstrzymuje się i nadal pokazuje ostatni odczyt, zamiast po cichu zawodzić."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuje se jen přes Wi-Fi. Na mobilních datech se aplikace pozastaví a dál zobrazuje poslední hodnotu, místo aby tiše selhala."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Wi-Fi'de yenilenir. Hücresel veride uygulama duraklar ve sessizce başarısız olmak yerine son okumayı göstermeyi sürdürür."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi でのみ更新します。モバイル通信では一時停止し、黙って失敗せずに最後の値を表示し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi에서만 새로 고칩니다. 셀룰러에서는 일시 중지하고, 조용히 실패하는 대신 마지막 값을 계속 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 Wi-Fi 下刷新。使用蜂窝网络时应用会暂停，并继续显示最后一次读数，而不是悄悄失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在 Wi-Fi 下重新整理。使用行動網路時會暫停，並繼續顯示最後一次讀數，而不是悄悄失敗。"
          }
        }
      }
    },
    "Refreshes over Wi-Fi and cellular. A refresh is a few hundred kilobytes.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлюється через Wi-Fi і мобільну мережу. Одне оновлення — кілька сотень кілобайтів."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert über WLAN und Mobilfunk. Eine Aktualisierung sind ein paar hundert Kilobyte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualisation via Wi-Fi et données cellulaires. Une actualisation représente quelques centaines de kilo-octets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se actualiza por Wi-Fi y datos móviles. Cada actualización son unos cientos de kilobytes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aggiorna via Wi-Fi e rete cellulare. Un aggiornamento pesa poche centinaia di kilobyte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza por Wi-Fi e dados móveis. Cada atualização são algumas centenas de kilobytes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ververst via wifi en mobiel netwerk. Eén verversing is een paar honderd kilobyte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdaterar via Wi-Fi och mobilnät. En uppdatering är några hundra kilobyte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdaterer over Wi-Fi og mobilnett. Én oppdatering er noen hundre kilobyte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdaterer via Wi-Fi og mobilnet. En opdatering fylder et par hundrede kilobyte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivittyy Wi-Fin ja mobiiliverkon kautta. Yksi päivitys on muutama sata kilotavua."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odświeża przez Wi-Fi i sieć komórkową. Jedno odświeżenie to kilkaset kilobajtów."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuje se přes Wi-Fi i mobilní data. Jedna aktualizace má několik set kilobajtů."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi ve hücresel veriyle yenilenir. Bir yenileme birkaç yüz kilobayttır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi とモバイル通信で更新します。1回の更新は数百キロバイトです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi와 셀룰러로 새로 고칩니다. 한 번의 갱신은 수백 킬로바이트입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Wi-Fi 和蜂窝网络刷新。每次刷新约几百 KB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Wi-Fi 和行動網路重新整理。每次約數百 KB。"
          }
        }
      }
    },
