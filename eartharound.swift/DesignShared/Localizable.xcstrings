    "Sunspot number R = 10·groups + spots (Wolf/SILSO), from NOAA's solar-region report.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Число сонячних плям R = 10·групи + плями (Вольф/SILSO), зі звіту NOAA про сонячні області."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonnenfleckenzahl R = 10·Gruppen + Flecken (Wolf/SILSO), aus dem NOAA-Bericht zu Sonnenregionen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de taches R = 10·groupes + taches (Wolf/SILSO), d'après le rapport NOAA sur les régions solaires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de manchas R = 10·grupos + manchas (Wolf/SILSO), del informe de regiones solares de NOAA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Numero di macchie R = 10·gruppi + macchie (Wolf/SILSO), dal rapporto NOAA sulle regioni solari."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de manchas R = 10·grupos + manchas (Wolf/SILSO), do relatório de regiões solares da NOAA."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonnevlekgetal R = 10·groepen + vlekken (Wolf/SILSO), uit NOAA's rapport over zonneregio's."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Solfläckstal R = 10·grupper + fläckar (Wolf/SILSO), från NOAA:s rapport om solregioner."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Solflekktall R = 10·grupper + flekker (Wolf/SILSO), fra NOAAs rapport om solregioner."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Solpletstal R = 10·grupper + pletter (Wolf/SILSO), fra NOAA's rapport om solregioner."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auringonpilkkuluku R = 10·ryhmät + pilkut (Wolf/SILSO), NOAA:n aurinkoalueraportista."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba plam R = 10·grupy + plamy (Wolf/SILSO), z raportu NOAA o obszarach słonecznych."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo slunečních skvrn R = 10·skupiny + skvrny (Wolf/SILSO), ze zprávy NOAA o slunečních oblastech."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneş lekesi sayısı R = 10·grup + leke (Wolf/SILSO), NOAA güneş bölgesi raporundan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黒点相対数 R = 10·群数 + 黒点数（ウォルフ/SILSO）、NOAA の太陽領域レポートより。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흑점 수 R = 10·군 + 흑점(볼프/SILSO), NOAA 태양 영역 보고서 기준."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑子相对数 R = 10·群数 + 黑子数（沃尔夫/SILSO），来自 NOAA 太阳活动区报告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "黑子相對數 R = 10·群數 + 黑子數（沃爾夫/SILSO），來自 NOAA 太陽活動區報告。"
          }
        }
      }
    },
    "The 28-level Kp scale (Bartels) with NOAA G-scale color bands. Ap is the day's mean amplitude.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "28-рівнева шкала Kp (Бартельс) із кольоровими смугами G-шкали NOAA. Ap — середня добова амплітуда."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 28-stufige Kp-Skala (Bartels) mit den Farbbändern der NOAA-G-Skala. Ap ist die mittlere Tagesamplitude."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'échelle Kp à 28 niveaux (Bartels) avec les bandes de couleur de l'échelle G de la NOAA. Ap est l'amplitude moyenne du jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escala Kp de 28 niveles (Bartels) con las bandas de color de la escala G de NOAA. Ap es la amplitud media del día."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scala Kp a 28 livelli (Bartels) con le bande colorate della scala G NOAA. Ap è l'ampiezza media giornaliera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escala Kp de 28 níveis (Bartels) com as faixas de cor da escala G da NOAA. Ap é a amplitude média do dia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De 28-traps Kp-schaal (Bartels) met de kleurbanden van de NOAA G-schaal. Ap is de gemiddelde dagamplitude."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den 28-gradiga Kp-skalan (Bartels) med färgband från NOAA:s G-skala. Ap är dygnets medelamplitud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den 28-trinns Kp-skalaen (Bartels) med fargebånd fra NOAAs G-skala. Ap er døgnets gjennomsnittsamplitude."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den 28-trins Kp-skala (Bartels) med farvebånd fra NOAA's G-skala. Ap er døgnets gennemsnitlige amplitude."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "28-portainen Kp-asteikko (Bartels) NOAA:n G-asteikon väripalkein. Ap on vuorokauden keskiamplitudi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "28-stopniowa skala Kp (Bartels) z pasmami kolorów skali G NOAA. Ap to średnia amplituda dobowa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "28stupňová škála Kp (Bartels) s barevnými pásmy NOAA G-škály. Ap je průměrná denní amplituda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "28 kademeli Kp ölçeği (Bartels), NOAA G ölçeği renk bantlarıyla. Ap, günün ortalama genliğidir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "28段階の Kp スケール（バーテルス）と NOAA G スケールのカラーバンド。Ap はその日の平均振幅です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "28단계 Kp 척도(바텔스)와 NOAA G 등급 색상 밴드. Ap는 그날의 평균 진폭입니다."
