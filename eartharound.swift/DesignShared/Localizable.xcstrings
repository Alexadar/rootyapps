          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kp planétaire, niveau de tempête, chance d'aurore et vent solaire — en direct de la NOAA."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kp planetario, nivel de tormenta, probabilidad de aurora y viento solar: en vivo desde NOAA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kp planetario, livello di tempesta, probabilità di aurora e vento solare — in diretta da NOAA."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kp planetário, nível de tempestade, chance de aurora e vento solar — ao vivo da NOAA."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Planetaire Kp, stormniveau, kans op poollicht en zonnewind — live van de NOAA."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planetärt Kp, stormnivå, norrskenschans och solvind – live från NOAA."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planetarisk Kp, stormnivå, nordlyssjanse og solvind – direkte fra NOAA."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planetarisk Kp, stormniveau, chance for nordlys og solvind – live fra NOAA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Planetaarinen Kp, myrskytaso, revontulten mahdollisuus ja aurinkotuuli – suorana NOAA:lta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Planetarny Kp, poziom burzy, szansa na zorzę i wiatr słoneczny — na żywo z NOAA."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Planetární Kp, úroveň bouře, šance na polární záři a sluneční vítr — živě z NOAA."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezegensel Kp, fırtına düzeyi, kutup ışığı olasılığı ve güneş rüzgârı — NOAA'dan canlı."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "惑星 Kp、嵐のレベル、オーロラの可能性、太陽風 — NOAA からライブで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행성 Kp, 폭풍 등급, 오로라 가능성, 태양풍 — NOAA에서 실시간으로."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行星 Kp、风暴等级、极光机会与太阳风——来自 NOAA 的实时数据。"
