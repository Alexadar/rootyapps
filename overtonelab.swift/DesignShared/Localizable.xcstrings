    "Equal-power (−3 dB) keeps loudness constant across the stereo field; linear (−6 dB) keeps summed level constant in mono.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Equal-Power (−3 dB) hält die Lautheit über das Stereofeld konstant; linear (−6 dB) hält den Summenpegel in Mono konstant."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'équi-puissance (−3 dB) garde une sonie constante sur le champ stéréo ; la loi linéaire (−6 dB) garde le niveau sommé constant en mono."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La potencia constante (−3 dB) mantiene la sonoridad estable en el campo estéreo; la lineal (−6 dB) mantiene el nivel sumado en mono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La potenza costante (−3 dB) mantiene il volume costante nel campo stereo; la lineare (−6 dB) mantiene costante il livello sommato in mono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stała moc (−3 dB) utrzymuje głośność w polu stereo; liniowa (−6 dB) utrzymuje poziom sumy w mono."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рівна потужність (−3 dB) тримає гучність сталою в стереополі; лінійна (−6 dB) тримає сталим сумарний рівень у моно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Konstantní výkon (−3 dB) drží hlasitost ve stereu; lineární (−6 dB) drží součtovou úroveň v monu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az azonos teljesítmény (−3 dB) állandó hangosságot tart a sztereó mezőben; a lineáris (−6 dB) az összegzett monószintet tartja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puterea constantă (−3 dB) menține sonoritatea în câmpul stereo; cea liniară (−6 dB) menține nivelul însumat în mono."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ίση ισχύς (−3 dB) κρατά σταθερή την ένταση στο στερεοφωνικό πεδίο· η γραμμική (−6 dB) κρατά σταθερή τη στάθμη στο mono."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşit güç (−3 dB) stereo alanda gürlüğü sabit tutar; doğrusal (−6 dB) mono toplam seviyeyi sabit tutar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelijk vermogen (−3 dB) houdt de luidheid constant in het stereobeeld; lineair (−6 dB) houdt het gesommeerde niveau in mono constant."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lika effekt (−3 dB) håller ljudstyrkan konstant i stereofältet; linjär (−6 dB) håller den summerade nivån konstant i mono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "等パワー（−3 dB）はステレオ内で音量感を一定に保ち、リニア（−6 dB）はモノでの合成レベルを一定に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등파워(−3 dB)는 스테레오 필드 전체에서 음량감을 일정하게, 선형(−6 dB)은 모노 합산 레벨을 일정하게 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A potência constante (−3 dB) mantém o volume constante no campo estéreo; a linear (−6 dB) mantém o nível somado em mono."
          }
        }
      },
      "comment": "Pan law footnote"
    },
