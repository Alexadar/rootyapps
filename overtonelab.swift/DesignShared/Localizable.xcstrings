    "Sound travels 343 m/s. Use this to time-align a delayed speaker to a distant one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schall legt 343 m/s zurück. Damit richtest du einen verzögerten Lautsprecher zeitlich auf einen entfernten aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son parcourt 343 m/s. Utilisez-le pour aligner temporellement une enceinte retardée sur une enceinte éloignée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido viaja a 343 m/s. Úsalo para alinear en el tiempo un altavoz retardado con otro lejano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suono viaggia a 343 m/s. Usalo per allineare nel tempo un diffusore ritardato a uno lontano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk biegnie 343 m/s. Użyj tego, aby zsynchronizować opóźniony głośnik z odległym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук долає 343 м/с. Використайте це, щоб вирівняти в часі затриманий гучномовець із віддаленим."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk se šíří 343 m/s. Použijte to k časovému sladění zpožděného reproduktoru se vzdáleným."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang 343 m/s-mal terjed. Ezzel időzítsd a késleltetett hangszórót a távolihoz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunetul se propagă cu 343 m/s. Folosește asta pentru a alinia în timp o boxă întârziată cu una îndepărtată."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος ταξιδεύει 343 m/s. Χρησιμοποίησέ το για χρονική ευθυγράμμιση ενός καθυστερημένου ηχείου με ένα μακρινό."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses 343 m/s hızla yayılır. Gecikmeli bir hoparlörü uzaktakiyle zaman hizalamak için bunu kullanın."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geluid legt 343 m/s af. Gebruik dit om een vertraagde luidspreker op een verre af te stemmen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljud färdas 343 m/s. Använd detta för att tidsjustera en fördröjd högtalare mot en avlägsen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音速は 343 m/s。離れたスピーカーに対して遅延スピーカーをタイムアラインするのに使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 343 m/s로 이동합니다. 멀리 있는 스피커에 지연 스피커를 타임 얼라인할 때 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som viaja a 343 m/s. Use isto para alinhar no tempo uma caixa atrasada com outra distante."
          }
