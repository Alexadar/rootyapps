          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Közepes Qts — rugalmas; zárt és basszreflex is jó."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Qts mediu — flexibil; merge și închisă, și bass-reflex."
