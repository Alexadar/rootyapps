    "Qtc 0.707 = flat, 0.5 = maximally damped/transient-tight, >0.8 = warmer with a bump.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = linear, 0,5 = maximal bedämpft/impulstreu, >0,8 = wärmer mit Buckel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = plat, 0,5 = amortissement maximal/transitoires serrés, >0,8 = plus chaud avec une bosse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = plano, 0,5 = máximo amortiguamiento/transitorios ajustados, >0,8 = más cálido con una joroba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = piatto, 0,5 = massimo smorzamento/transienti precisi, >0,8 = più caldo con una gobba."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = płasko, 0,5 = maksymalne tłumienie/zwarte transjenty, >0,8 = cieplej z podbiciem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = рівно, 0,5 = максимально задемпфовано/чіткі транзієнти, >0,8 = тепліше з горбом."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = rovně, 0,5 = maximálně tlumené/přesné transienty, >0,8 = tepleji s hrbem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = lineáris, 0,5 = maximálisan csillapított/feszes tranziensek, >0,8 = melegebb, púppal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = plat, 0,5 = amortizare maximă/tranzienți fermi, >0,8 = mai cald, cu o cocoașă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = επίπεδο, 0,5 = μέγιστη απόσβεση/σφιχτά transients, >0,8 = πιο ζεστό με καμπούρα."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = düz, 0,5 = maksimum sönümlü/sıkı transiyent, >0,8 = tümsekli, daha sıcak."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = vlak, 0,5 = maximaal gedempt/strakke transiënten, >0,8 = warmer met een bult."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = platt, 0,5 = maximalt dämpat/stram transient, >0,8 = varmare med en puckel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0.707＝フラット、0.5＝最大制動でトランジェントが締まる、0.8 超＝膨らみのある温かい音。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0.707 = 평탄, 0.5 = 최대 감쇠/타이트한 트랜지언트, 0.8 초과 = 부풀며 따뜻한 소리."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qtc 0,707 = plano, 0,5 = amortecimento máximo/transientes firmes, >0,8 = mais quente com uma elevação."
          }
        }
      },
      "comment": "Sealed box footnote"
    },
