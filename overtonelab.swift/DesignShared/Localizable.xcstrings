    "f = 1/(2π·√(L·C)). The tuned frequency of a passive LC crossover section or trap.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "f = 1/(2π·√(L·C)). Die Abstimmfrequenz eines passiven LC-Weichenzweigs oder Saugkreises."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "f = 1/(2π·√(L·C)). Fréquence d'accord d'une section de filtrage LC passive ou d'un bouchon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "f = 1/(2π·√(L·C)). La frecuencia de sintonía de una sección LC pasiva de crossover o de una trampa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "f = 1/(2π·√(L·C)). La frequenza di accordo di una sezione LC passiva di crossover o di una trappola."
