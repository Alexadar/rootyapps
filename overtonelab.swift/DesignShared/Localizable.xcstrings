    "Sample-accurate edit points: samples = seconds × sample rate.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample-genaue Schnittpunkte: Samples = Sekunden × Abtastrate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points d'édition au sample près : samples = secondes × fréquence d'échantillonnage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos de edición con precisión de muestra: muestras = segundos × frecuencia de muestreo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punti di edit precisi al campione: campioni = secondi × frequenza di campionamento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkty edycji z dokładnością do próbki: próbki = sekundy × częstotliwość próbkowania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точки монтажу з точністю до семпла: семпли = секунди × частота дискретизації."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Editační body přesné na vzorek: vzorky = sekundy × vzorkovací frekvence."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta pontosságú vágópontok: minták = másodperc × mintavételi frekvencia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puncte de montaj precise la eșantion: eșantioane = secunde × rata de eșantionare."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημεία μοντάζ με ακρίβεια δείγματος: δείγματα = δευτερόλεπτα × ρυθμός δειγματοληψίας."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örnek hassasiyetinde kesim noktaları: örnek = saniye × örnekleme hızı."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample-nauwkeurige editpunten: samples = seconden × samplerate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampelexakta klipppunkter: sampel = sekunder × samplingsfrekvens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプル単位の編集点：サンプル数 = 秒 × サンプルレート。"
