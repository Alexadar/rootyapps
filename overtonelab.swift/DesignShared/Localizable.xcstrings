            "state": "translated",
            "value": "0 dBu = 0,7746 V (√(600 Ω'a 1 mW)); 0 dBV = 1 V. Aralarında 2,2 dB fark var."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dBu = 0,7746 V (√(1 mW in 600 Ω)); 0 dBV = 1 V. Ze verschillen 2,2 dB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dBu = 0,7746 V (√(1 mW i 600 Ω)); 0 dBV = 1 V. De skiljer sig 2,2 dB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dBu = 0.7746 V（600 Ω に 1 mW の√）、0 dBV = 1 V。差は 2.2 dB です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dBu = 0.7746 V(600 Ω에 1 mW의 √), 0 dBV = 1 V. 둘의 차이는 2.2 dB입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dBu = 0,7746 V (√(1 mW em 600 Ω)); 0 dBV = 1 V. Diferem em 2,2 dB."
          }
        }
      },
      "comment": "Levels reference footnote"
    },
