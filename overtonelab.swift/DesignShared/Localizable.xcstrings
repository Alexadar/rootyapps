    "From the driver's own datasheet parameters. Qtc 0.707 is the maximally-flat (Butterworth) sealed alignment.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus den Datenblattparametern des Chassis. Qtc 0,707 ist die maximal flache (Butterworth) geschlossene Abstimmung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'après les paramètres du haut-parleur. Qtc 0,707 est l'alignement clos maximalement plat (Butterworth)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de los parámetros de la ficha del altavoz. Qtc 0,707 es la alineación sellada máximamente plana (Butterworth)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai parametri di targa dell'altoparlante. Qtc 0,707 è l'allineamento chiuso massimamente piatto (Butterworth)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z parametrów karty katalogowej głośnika. Qtc 0,707 to maksymalnie płaskie (Butterwortha) dostrojenie zamknięte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З параметрів даташита динаміка. Qtc 0,707 — максимально рівне (Баттерворта) закрите налаштування."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z parametrů datového listu reproduktoru. Qtc 0,707 je maximálně plochá (Butterworth) uzavřená sladěnost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangszóró adatlapi paramétereiből. A Qtc 0,707 a maximálisan lapos (Butterworth) zárt hangolás."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din parametrii de catalog ai difuzorului. Qtc 0,707 este alinierea închisă maxim plată (Butterworth)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από τις παραμέτρους του μεγαφώνου. Qtc 0,707 είναι η μέγιστα επίπεδη (Butterworth) κλειστή ευθυγράμμιση."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücünün kendi veri sayfası parametrelerinden. Qtc 0,707, maksimum düz (Butterworth) kapalı hizalamadır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit de datasheetparameters van de luidspreker. Qtc 0,707 is de maximaal vlakke (Butterworth) gesloten afstemming."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från elementets egna datablad. Qtc 0,707 är den maximalt flata (Butterworth) slutna avstämningen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライバーのデータシート値から算出。Qtc 0.707 は最大平坦（バターワース）の密閉アライメントです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이버 데이터시트 파라미터 기준. Qtc 0.707은 최대 평탄(버터워스) 밀폐형 정렬입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir dos parâmetros da ficha do alto-falante. Qtc 0,707 é o alinhamento selado maximamente plano (Butterworth)."
          }
        }
      },
      "comment": "Thiele footnote"
    },
