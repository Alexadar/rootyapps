    "Add to the physical length for the effective acoustic length at each open end.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur physischen Länge addieren, um die effektive akustische Länge an jedem offenen Ende zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À ajouter à la longueur physique pour obtenir la longueur acoustique effective à chaque extrémité ouverte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Súmalo a la longitud física para obtener la longitud acústica efectiva en cada extremo abierto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da sommare alla lunghezza fisica per la lunghezza acustica effettiva a ogni estremità aperta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj do długości fizycznej, aby uzyskać efektywną długość akustyczną na każdym otwartym końcu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте до фізичної довжини, щоб отримати ефективну акустичну довжину на кожному відкритому кінці."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přičtěte k fyzické délce pro efektivní akustickou délku na každém otevřeném konci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá a fizikai hosszhoz az effektív akusztikus hosszért minden nyitott végen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă la lungimea fizică pentru lungimea acustică efectivă la fiecare capăt deschis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσέ το στο φυσικό μήκος για το ενεργό ακουστικό μήκος σε κάθε ανοιχτό άκρο."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her açık uçtaki etkin akustik uzunluk için fiziksel uzunluğa ekleyin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel dit bij de fysieke lengte op voor de effectieve akoestische lengte aan elk open uiteinde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till den fysiska längden för den effektiva akustiska längden vid varje öppen ände."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各開放端での実効音響長を得るには、物理長に加算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 열린 끝에서의 유효 음향 길이를 얻으려면 물리적 길이에 더하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Some ao comprimento físico para obter o comprimento acústico efetivo em cada extremidade aberta."
          }
        }
      },
      "comment": "End correction footnote"
    },
