    "Modeled as a tube closed at the glottis, open at the lips (quarter-wave).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelliert als Rohr, an der Glottis geschlossen und an den Lippen offen (Viertelwellen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modélisé comme un tube fermé à la glotte et ouvert aux lèvres (quart d'onde)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelado como un tubo cerrado en la glotis y abierto en los labios (cuarto de onda)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellato come un tubo chiuso alla glottide e aperto alle labbra (quarto d'onda)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelowany jako rura zamknięta przy głośni i otwarta przy wargach (ćwierćfalowa)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель — трубка, закрита біля голосової щілини й відкрита біля губ (чвертьхвильова)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelováno jako trubice uzavřená u hlasivkové štěrbiny a otevřená u rtů (čtvrtvlnná)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csőként modellezve, a hangrésnél zárt, az ajkaknál nyitott (negyedhullám)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelat ca un tub închis la glotă și deschis la buze (sfert de undă)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μοντελοποιείται ως σωλήνας κλειστός στη γλωττίδα και ανοιχτός στα χείλη (τέταρτο κύματος)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glottiste kapalı, dudaklarda açık bir boru olarak modellenir (çeyrek dalga)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemodelleerd als een buis, gesloten bij de stemspleet en open bij de lippen (kwartgolf)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellerad som ett rör, slutet vid glottis och öppet vid läpparna (kvartsvåg)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声門で閉じ、口唇で開いた管（1/4 波長）としてモデル化しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성문에서 닫히고 입술에서 열린 관(1/4 파장)으로 모델링합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelado como um tubo fechado na glote e aberto nos lábios (quarto de onda)."
          }
        }
      },
      "comment": "Vocal tract footnote"
    },
