    "Free-field inverse-square law: every doubling of distance drops the level 6 dB.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freifeld-Abstandsgesetz: Jede Verdopplung der Entfernung senkt den Pegel um 6 dB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loi en carré inverse en champ libre : chaque doublement de distance fait chuter le niveau de 6 dB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ley del cuadrado inverso en campo libre: cada duplicación de la distancia baja el nivel 6 dB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge dell'inverso del quadrato in campo libero: ogni raddoppio della distanza abbassa il livello di 6 dB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawo odwrotności kwadratu w polu swobodnym: każde podwojenie odległości obniża poziom o 6 dB."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закон оберненого квадрата у вільному полі: кожне подвоєння відстані знижує рівень на 6 dB."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zákon převrácených čtverců ve volném poli: každé zdvojnásobení vzdálenosti sníží úroveň o 6 dB."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szabadtéri fordított négyzetes törvény: a távolság minden megkétszereződése 6 dB-lel csökkenti a szintet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Legea inversului pătratului în câmp liber: fiecare dublare a distanței scade nivelul cu 6 dB."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νόμος αντιστρόφου τετραγώνου σε ελεύθερο πεδίο: κάθε διπλασιασμός της απόστασης ρίχνει τη στάθμη κατά 6 dB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serbest alanda ters kare yasası: mesafenin her iki katına çıkışı seviyeyi 6 dB düşürür."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omgekeerde kwadratenwet in het vrije veld: elke verdubbeling van de afstand verlaagt het niveau met 6 dB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fritt fält, avståndslagen: varje fördubbling av avståndet sänker nivån 6 dB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自由音場の逆二乗則：距離が 2 倍になるごとにレベルは 6 dB 下がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자유 음장 역제곱 법칙: 거리가 두 배가 될 때마다 레벨이 6 dB 떨어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lei do inverso do quadrado em campo livre: cada duplicação da distância reduz o nível em 6 dB."
          }
        }
      },
      "comment": "SPL footnote"
    },
