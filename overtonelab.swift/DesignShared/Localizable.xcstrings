    "Theoretical full-scale-sine SNR = 6.02·N + 1.76 dB. 16-bit ≈ 98 dB, 24-bit ≈ 146 dB.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Theoretischer Vollaussteuerungs-Sinus-SNR = 6,02·N + 1,76 dB. 16 Bit ≈ 98 dB, 24 Bit ≈ 146 dB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RSB théorique d'une sinusoïde pleine échelle = 6,02·N + 1,76 dB. 16 bits ≈ 98 dB, 24 bits ≈ 146 dB."
          }
        },
        "es": {
