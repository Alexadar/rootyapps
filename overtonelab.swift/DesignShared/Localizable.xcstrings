    "Tenney height = log₂(n·d): lower means simpler and more consonant.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenney-Höhe = log₂(n·d): niedriger bedeutet einfacher und konsonanter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur de Tenney = log₂(n·d) : plus elle est basse, plus le rapport est simple et consonant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura de Tenney = log₂(n·d): más baja significa más simple y consonante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza di Tenney = log₂(n·d): più bassa significa più semplice e consonante."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysokość Tenneya = log₂(n·d): niższa oznacza prostszy i bardziej konsonansowy interwał."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Висота Тенні = log₂(n·d): менша означає простіше й консонантніше."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenneyho výška = log₂(n·d): nižší znamená jednodušší a konsonantnější."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenney-magasság = log₂(n·d): az alacsonyabb egyszerűbb és konszonánsabb."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înălțimea Tenney = log₂(n·d): mai mică înseamnă mai simplu și mai consonant."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ύψος Tenney = log₂(n·d): χαμηλότερο σημαίνει απλούστερο και πιο σύμφωνο."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenney yüksekliği = log₂(n·d): daha düşük, daha basit ve daha uyumlu demektir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenney-hoogte = log₂(n·d): lager betekent eenvoudiger en consonanter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenney-höjd = log₂(n·d): lägre betyder enklare och mer konsonant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テニー高 = log₂(n·d)：低いほど単純で協和的です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테니 높이 = log₂(n·d): 낮을수록 단순하고 협화적입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura de Tenney = log₂(n·d): quanto menor, mais simples e consonante."
          }
        }
      },
      "comment": "Partch footnote"
    },
