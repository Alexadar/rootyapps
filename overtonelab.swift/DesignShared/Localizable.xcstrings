        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "f = 1/(2π·√(L·C)). Частота налаштування пасивної LC-ланки кросовера або пастки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "f = 1/(2π·√(L·C)). Ladicí frekvence pasivní LC sekce výhybky nebo pasti."
          }
        },
        "hu": {
