          "stringUnit": {
            "state": "translated",
            "value": "Qts medio: flexible; sellada o bass-reflex funcionan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qts medio — flessibile; vanno bene sia chiusa sia bass-reflex."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnie Qts — uniwersalne; zamknięta i bas-refleks zadziałają."
          }
