    "0 dBu = 0.7746 V (√(1 mW into 600 Ω)); 0 dBV = 1 V. They differ by 2.2 dB.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dBu = 0,7746 V (√(1 mW an 600 Ω)); 0 dBV = 1 V. Sie unterscheiden sich um 2,2 dB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dBu = 0,7746 V (√(1 mW sur 600 Ω)) ; 0 dBV = 1 V. Ils diffèrent de 2,2 dB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dBu = 0,7746 V (√(1 mW en 600 Ω)); 0 dBV = 1 V. Difieren en 2,2 dB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dBu = 0,7746 V (√(1 mW su 600 Ω)); 0 dBV = 1 V. Differiscono di 2,2 dB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dBu = 0,7746 V (√(1 mW na 600 Ω)); 0 dBV = 1 V. Różnią się o 2,2 dB."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "0 dBu = 0,7746 В (√(1 мВт на 600 Ω)); 0 dBV = 1 В. Різниця — 2,2 dB."
