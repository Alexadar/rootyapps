    "Mid Qts — flexible; sealed or ported both work.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittleres Qts — flexibel; geschlossen und Bassreflex funktionieren beide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qts moyen — polyvalent : clos ou bass-reflex conviennent."
          }
