    "Two equal uncorrelated sources add +3 dB; 10 dB apart adds only ~0.4 dB.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei gleiche unkorrelierte Quellen ergeben +3 dB; bei 10 dB Abstand nur noch ~0,4 dB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux sources égales non corrélées ajoutent +3 dB ; à 10 dB d'écart, seulement ~0,4 dB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos fuentes iguales no correlacionadas suman +3 dB; con 10 dB de diferencia solo ~0,4 dB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due sorgenti uguali non correlate sommano +3 dB; con 10 dB di differenza solo ~0,4 dB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa jednakowe nieskorelowane źródła dają +3 dB; przy różnicy 10 dB tylko ~0,4 dB."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Два однакові некорельовані джерела дають +3 dB; за різниці 10 dB — лише ~0,4 dB."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva stejné nekorelované zdroje přidají +3 dB; při rozdílu 10 dB jen ~0,4 dB."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két azonos, korrelálatlan forrás +3 dB-t ad; 10 dB különbségnél csak ~0,4 dB-t."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Două surse egale necorelate adaugă +3 dB; la 10 dB diferență, doar ~0,4 dB."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δύο ίσες ασυσχέτιστες πηγές δίνουν +3 dB· με διαφορά 10 dB μόνο ~0,4 dB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşit ve ilişkisiz iki kaynak +3 dB ekler; aralarında 10 dB varsa yalnızca ~0,4 dB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee gelijke ongecorreleerde bronnen geven +3 dB; bij 10 dB verschil slechts ~0,4 dB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två lika okorrelerade källor ger +3 dB; med 10 dB skillnad bara ~0,4 dB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同レベルで無相関な 2 音源は +3 dB、10 dB 差なら約 0.4 dB しか増えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
