    "Two close tones beat at their difference — tune by slowing the beats to zero.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei nahe Töne schweben mit ihrer Differenz — stimme, indem du die Schwebungen auf null verlangsamst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux sons proches battent à leur différence — accordez en ralentissant les battements jusqu'à zéro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos tonos cercanos baten a su diferencia: afina reduciendo los batidos hasta cero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due suoni vicini battono alla loro differenza: accorda rallentando i battimenti fino a zero."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa bliskie dźwięki dudnią z różnicą częstotliwości — stroisz, spowalniając dudnienia do zera."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Два близькі тони б'ються з різницею частот — налаштовуйте, сповільнюючи биття до нуля."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva blízké tóny se zázní svým rozdílem — laďte zpomalováním zázněje k nule."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két közeli hang a különbségükkel lebeg — a hangolás a lebegés nullára lassítása."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Două sunete apropiate bat la diferența lor — acordează încetinind bătăile până la zero."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δύο κοντινοί τόνοι διακροτούν στη διαφορά τους — κούρδισε επιβραδύνοντας τις διακροτήσεις στο μηδέν."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birbirine yakın iki ton, farkları kadar vurur — vuruları sıfıra yavaşlatarak akort edin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee dicht bij elkaar liggende tonen zweven met hun verschil — stem door de zweving naar nul te vertragen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två närliggande toner svävar med sin differens — stäm genom att sakta ner svävningarna till noll."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近い 2 音はその差でうなります — うなりがゼロになるまで遅くして調律します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가까운 두 음은 그 차이만큼 맥놀이합니다 — 맥놀이가 0이 되도록 늦추며 조율하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois tons próximos batem na diferença entre eles — afine desacelerando os batimentos até zero."
          }
        }
      },
      "comment": "Beats footnote"
    },
