    "Positive speeds close the gap (pitch up); negative open it (pitch down).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive Geschwindigkeiten verringern den Abstand (höher); negative vergrößern ihn (tiefer)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vitesse positive réduit l'écart (son plus aigu) ; négative, elle l'augmente (plus grave)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las velocidades positivas cierran la distancia (sube el tono); las negativas la abren (baja)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocità positive riducono la distanza (suono più acuto); negative la aumentano (più grave)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prędkości dodatnie zmniejszają odległość (dźwięk wyższy); ujemne ją zwiększają (niższy)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додатні швидкості скорочують відстань (вище); від'ємні — збільшують (нижче)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kladné rychlosti zmenšují vzdálenost (výše); záporné ji zvětšují (níže)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pozitív sebesség csökkenti a távolságot (magasabb hang); a negatív növeli (mélyebb)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitezele pozitive scurtează distanța (sunet mai înalt); cele negative o măresc (mai jos)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θετικές ταχύτητες μικραίνουν την απόσταση (ψηλότερα)· αρνητικές τη μεγαλώνουν (χαμηλότερα)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozitif hızlar mesafeyi kapatır (perde yükselir); negatif olanlar açar (perde düşer)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Positieve snelheden verkleinen de afstand (hoger); negatieve vergroten hem (lager)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Positiva hastigheter minskar avståndet (högre ton); negativa ökar det (lägre ton)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速度が正なら距離が縮まり音程が上がり、負なら広がって下がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속도가 양수면 거리가 좁아져 음이 높아지고, 음수면 벌어져 낮아집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocidades positivas encurtam a distância (som mais agudo); negativas a aumentam (mais grave)."
          }
        }
      },
      "comment": "Doppler footnote"
    },
