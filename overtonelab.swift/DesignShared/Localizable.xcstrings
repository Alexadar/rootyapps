    "Drop-frame skips 2 frame numbers each minute (except every 10th) to track real 29.97 fps time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop-Frame überspringt jede Minute 2 Frame-Nummern (außer jede 10.), um der echten 29,97-fps-Zeit zu folgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le drop-frame saute 2 numéros d'image chaque minute (sauf toutes les 10) pour suivre le temps réel à 29,97 ips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El drop-frame omite 2 números de fotograma cada minuto (excepto cada 10) para seguir el tiempo real a 29,97 fps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il drop-frame salta 2 numeri di fotogramma ogni minuto (tranne ogni 10ª) per seguire il tempo reale a 29,97 fps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop-frame pomija 2 numery klatek co minutę (poza co dziesiątą), aby nadążać za realnym czasem 29,97 fps."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop-frame пропускає 2 номери кадрів щохвилини (крім кожної 10-ї), щоб відповідати реальному часу 29,97 fps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop-frame vynechá každou minutu 2 čísla snímků (kromě každé desáté), aby sledoval reálný čas 29,97 fps."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A drop-frame percenként 2 képkockaszámot kihagy (kivéve minden 10.-et), hogy kövesse a valós 29,97 fps időt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop-frame sare 2 numere de cadru în fiecare minut (cu excepția fiecărui al 10-lea), pentru a urmări timpul real la 29,97 fps."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το drop-frame παραλείπει 2 αριθμούς καρέ κάθε λεπτό (εκτός κάθε 10ου) ώστε να ακολουθεί τον πραγματικό χρόνο στα 29,97 fps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop-frame, gerçek 29,97 fps zamanı takip etmek için her dakika 2 kare numarası atlar (her 10. hariç)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop-frame slaat elke minuut 2 framenummers over (behalve elke 10e) om de echte 29,97 fps-tijd te volgen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop-frame hoppar över 2 bildnummer varje minut (utom var tionde) för att följa verklig tid vid 29,97 fps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドロップフレームは実時間の 29.97 fps に追従するため、毎分 2 つのフレーム番号を飛ばします（10 分ごとを除く）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드롭 프레임은 실제 29.97 fps 시간을 따라가기 위해 매분 프레임 번호 2개를 건너뜁니다(매 10분 제외)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O drop-frame pula 2 números de quadro a cada minuto (exceto a cada 10º) para acompanhar o tempo real de 29,97 fps."
          }
        }
      },
      "comment": "Timecode footnote"
    },
