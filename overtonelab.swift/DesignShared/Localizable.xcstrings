    "Follows your device unless you pick a language here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgt deinem Gerät, sofern du hier keine Sprache wählst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit votre appareil, sauf si vous choisissez une langue ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a tu dispositivo salvo que elijas un idioma aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue il dispositivo, a meno che tu non scelga una lingua qui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podąża za ustawieniem urządzenia, chyba że wybierzesz język tutaj."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слідує за пристроєм, доки ви не оберете мову тут."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řídí se zařízením, dokud zde nevyberete jazyk."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A készülékedet követi, hacsak itt nem választasz nyelvet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmează dispozitivul, dacă nu alegi o limbă aici."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακολουθεί τη συσκευή σου, εκτός αν επιλέξεις γλώσσα εδώ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada bir dil seçmediğiniz sürece cihazınızı izler."
          }
