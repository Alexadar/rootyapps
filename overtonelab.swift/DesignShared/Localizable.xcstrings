    "Tap a technique to load it into the Array screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein Verfahren an, um es in den Anordnungs-Screen zu laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une technique pour la charger dans l'écran Couple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una técnica para cargarla en la pantalla de configuración."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una tecnica per caricarla nella schermata Coppia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij techniki, aby wczytać ją do ekranu układu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться техніки, щоб завантажити її на екран пари."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na techniku ji načtete do obrazovky sestavy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy technikára, hogy betöltsd az elrendezés képernyőre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge o tehnică pentru a o încărca în ecranul de configurație."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε μια τεχνική για να φορτωθεί στην οθόνη διάταξης."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tekniğe dokunarak dizilim ekranına yükleyin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een techniek om die in het opstellingsscherm te laden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en teknik för att läsa in den i uppställningsvyn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方式をタップするとアレイ画面に読み込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기법을 탭하면 배열 화면에 불러옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma técnica para carregá-la na tela de arranjo."
          }
        }
      },
      "comment": "SRA presets footnote"
    },
    "Tape/varispeed couples pitch and speed: +12 st doubles the playback rate.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Band/Varispeed koppelt Tonhöhe und Geschwindigkeit: +12 Halbtöne verdoppeln die Abspielrate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bande/varispeed couple hauteur et vitesse : +12 demi-tons doublent la vitesse de lecture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cinta/varispeed acopla altura y velocidad: +12 semitonos duplican la velocidad de reproducción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastro/varispeed accoppia altezza e velocità: +12 semitoni raddoppiano la velocità di riproduzione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taśma/varispeed sprzęga wysokość i prędkość: +12 półtonów podwaja prędkość odtwarzania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрічка/varispeed поєднує висоту й швидкість: +12 півтонів подвоюють швидкість відтворення."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Páska/varispeed spojuje výšku a rychlost: +12 půltónů zdvojnásobí rychlost přehrávání."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szalag/varispeed összeköti a hangmagasságot és a sebességet: +12 félhang duplázza a lejátszási sebességet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Banda/varispeed cuplează înălțimea și viteza: +12 semitonuri dublează viteza de redare."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ταινία/varispeed συνδέει τονικό ύψος και ταχύτητα: +12 ημιτόνια διπλασιάζουν την ταχύτητα αναπαραγωγής."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bant/varispeed perde ile hızı birbirine bağlar: +12 yarım ses, oynatma hızını iki katına çıkarır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tape/varispeed koppelt toonhoogte en snelheid: +12 halve tonen verdubbelen de afspeelsnelheid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Band/varispeed kopplar tonhöjd och hastighet: +12 halvtoner fördubblar uppspelningshastigheten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テープ／バリスピードはピッチと速度が連動します：+12 半音で再生速度が 2 倍になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테이프/배리스피드는 피치와 속도가 연동됩니다: +12 반음이면 재생 속도가 2배가 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fita/varispeed acopla altura e velocidade: +12 semitons dobram a velocidade de reprodução."
          }
        }
      },
      "comment": "Varispeed footnote"
    },
