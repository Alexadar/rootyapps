    "Mean adult-male values, Peterson & Barney (1952). Dial a formant filter or synth to these to voice a vowel.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittelwerte erwachsener Männer, Peterson & Barney (1952). Stelle einen Formantfilter oder Synth darauf ein, um einen Vokal zu formen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs moyennes d'hommes adultes, Peterson & Barney (1952). Réglez un filtre de formants ou un synthé dessus pour produire une voyelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores medios de hombres adultos, Peterson & Barney (1952). Ajusta un filtro de formantes o un sinte a estos valores para vocalizar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori medi di uomini adulti, Peterson & Barney (1952). Imposta un filtro di formanti o un synth su questi valori per ottenere una vocale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartości średnie dla dorosłych mężczyzn, Peterson & Barney (1952). Ustaw na nie filtr formantowy lub syntezator, aby uzyskać samogłoskę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середні значення для дорослих чоловіків, Peterson & Barney (1952). Налаштуйте на них формантний фільтр чи синтезатор, щоб отримати голосну."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průměrné hodnoty dospělých mužů, Peterson & Barney (1952). Nastavte na ně formantový filtr nebo synth a získáte samohlásku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felnőtt férfiak átlagértékei, Peterson & Barney (1952). Állíts rá formánsszűrőt vagy szintit egy magánhangzóhoz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori medii pentru bărbați adulți, Peterson & Barney (1952). Reglează un filtru de formanți sau un synth pe ele pentru a rosti o vocală."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέσες τιμές ενήλικων ανδρών, Peterson & Barney (1952). Ρύθμισε ένα φίλτρο φορμάντ ή synth σε αυτές για ένα φωνήεν."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetişkin erkek ortalamaları, Peterson & Barney (1952). Bir sesli harf için formant filtresini veya synth'i bu değerlere ayarlayın."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemiddelde waarden van volwassen mannen, Peterson & Barney (1952). Stel een formantfilter of synth hierop in voor een klinker."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Medelvärden för vuxna män, Peterson & Barney (1952). Ställ in ett formantfilter eller en synt på dessa för att forma en vokal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成人男性の平均値、Peterson & Barney（1952）。フォルマントフィルターやシンセをこの値に設定すると母音になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성인 남성 평균값, Peterson & Barney(1952). 포먼트 필터나 신스를 이 값으로 맞추면 모음이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores médios de homens adultos, Peterson & Barney (1952). Ajuste um filtro de formantes ou sintetizador a eles para vocalizar."
          }
        }
      },
      "comment": "Vowels footnote"
    },
