<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The widget process cannot read the app's container. The forming thumbnail travels as a
	     file in this shared group — ActivityKit's content state is a few KB and cannot carry
	     pixels — so the extension needs the same group the app declares, spelled identically. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.oleksandr.aisixteen.architecture</string>
	</array>
</dict>
</plist>
